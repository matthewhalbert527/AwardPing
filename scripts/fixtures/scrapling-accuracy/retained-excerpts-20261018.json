          "meta_sha256": "77a03ffea19ba99a2700cf6068491b56c430b9bfacb00f636702ecccfce093b4",
          "text_ref": "sources/c28878c0-6a8b-5fa8-b99b-ec826b86d8f2/captures/2026-10-18T15-54-48-294Z/text.txt",
          "text_file_sha256": "1af285a9718c123bec3660d625d75cbfbd39e5c16da769b235c37beb1df1d009",
          "normalized_text_sha256": "355ede30c87e3a1ffea010ebefd6b2c28ccc58995254389dc530720a29b9a515"
        }
